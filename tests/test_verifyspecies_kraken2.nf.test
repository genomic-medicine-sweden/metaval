nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_verifyspecies_kraken2"
    profile "test_verifyspecies_kraken2"


    test("-profile test_verifyspecies_kraken2") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

            def stable_name_all      = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            //blastn: partly unstable files, see custom assertions

            //blastx:partly unstable files, see custom assertions

            //extracted_reads: partly unstable files, see custom assertions

            //bowtie2 align
            def bam_files_bowtie2_align  = getAllFilesFromDir(params.outdir, include: ['mapping/bowtie2/align/*.bam'])

            //bowtie2 build
            def stable_content_bowtie2_build = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/bowtie2/build/**/**/*'], ignoreFile: 'tests/.nftignore')

            //minimap2 index:partly unstable files, see custom assertions

            //minimap2 align
            def stable_content_minimap2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/minimap2/align/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_minimap2_align  = getAllFilesFromDir(params.outdir, include: ['mapping/minimap2/align/*bam'])

            //viral taxid
            def stable_content_viral_taxids = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['viral_taxids/*'], ignoreFile: 'tests/.nftignore')

            // samtools coverage
            def stable_content_samtools_coverage = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['samtools/coverage/*.txt'], ignoreFile: 'tests/.nftignore')

             //samtools depth
            def stable_content_samtools_depth = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['samtools/depth/*.tsv'], ignoreFile: 'tests/.nftignore')


            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },

                { assert new File("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert snapshot ( stable_name_all ).match("all_files") },

                //blastn
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastn/kraken2", include: ['*.txt']).collect{file ->
                        file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                ).match("blastn") },

                //blastx
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastx/kraken2", include: ['*.txt']).collect{file ->
                        file.getName() + '(kraken2) contains string:' + (
                            file.text.contains("Chryseobacterium") ||
                            file.text.contains("Influenza") ||
                            file.text.contains("Shigella")) },
                ).match("blastx") },

                //extracted reads files
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/extracted_reads/kraken2", include: ['*.fa']).collect{file ->
                        file.getName() + '(extracted reads kraken2) contains string:' + (
                            file.text.contains("SRR13439790") ||
                            file.text.contains("SRR13439813") ||
                            file.text.contains("SRR13439799") ||
                            file.text.contains("SRR13439802") ) },
                ).match("extracted_reads") },

                //bowtie2
                { assert snapshot (
                    bam_files_bowtie2_align.isEmpty() ? 'No BAM files' : bam_files_bowtie2_align.collect { file -> [file.getName() + " bowtie2 align header: " + bam(file.toString()).getHeader()] }
                ).match("bowtie2_align")},
                { assert snapshot (stable_content_bowtie2_build).match("bowtie2_build")},

                //minimap2 index
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/mapping/minimap2/index", include: ['**/*.mmi']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("minimap2_index") },
                { assert snapshot (
                    bam_files_minimap2_align.isEmpty() ? 'No BAM files' : bam_files_minimap2_align.collect { file -> [file.getName() + " minimap2 align md5: " + bam(file.toString()).getReadsMD5()] },
                    stable_content_minimap2_align
                ).match("minimap2_align") },

                //igv
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("igv") },

                //spades
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/spades/kraken2", include: ['*.fa','*log']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("spades_kraken2") },

                {assert snapshot (stable_content_viral_taxids).match("viral_taxids")},

                //metaval report
                { assert snapshot (
                    getAllFilesFromDir("$outputDir/report", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("report") },


                // samtools coverage
                { assert snapshot (stable_content_samtools_coverage).match("samtools_coverage") },

                 // samtools coverage
                  { assert snapshot(
                        getAllFilesFromDir("$outputDir/samtools/coverage_plot", include: ['*.png']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("samtools_coverage_plot") },

                 // samtools coverage
                { assert snapshot (stable_content_samtools_depth).match("samtools_depth") },


            )
        }
    }

}
