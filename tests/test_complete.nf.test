nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_complete"
    profile "test"


    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

	     def stable_name_all      = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

             //blastn: partly unstable files, see custom assertions

             //blastx:partly unstable files, see custom assertions

            //extracted_reads: partly unstable files, see custom assertions

            //bowtie2 align
            def stable_content_bowtie2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/bowtie2/align'], ignoreFile: 'tests/.nftignore')
            def bam_files_bowtie2_align  = getAllFilesFromDir(params.outdir, include: ['mapping/bowtie2/align/*.bam'])

            //bowtie2 build
            def stable_content_bowtie2_build = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/bowtie2/build/**/**/*'], ignoreFile: 'tests/.nftignore')

            //minimap2 index:partly unstable files, see custom assertions
            //def stable_content_minimap2_index= getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/minimap2/index/*'], ignoreFile: 'tests/.nftignore')

            //minimap2 align
            def stable_content_minimap2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['mapping/minimap2/align/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_minimap2_align  = getAllFilesFromDir(params.outdir, include: ['mapping/minimap2/align/*bam'])

            //pathogens blast: partly unstable files, see custom assertions

            //pathogens consensus
            def stable_content_pathogens_consensus = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/consensus/*'], ignoreFile: 'tests/.nftignore')

             //pathogens mapping bowtie2 build
            def stable_content_pathogens_bowtie2_build = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/mapping/bowtie2/build/bowtie2/*'], ignoreFile: 'tests/.nftignore')

             //bowtie2 align
            def stable_content_pathogens_bowtie2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/mapping/bowtie2/align/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_pathogens_bowtie2_align  = getAllFilesFromDir(params.outdir, include: ['pathogens/mapping/bowtie2/align/*.bam'])

             //pathogens reads blast input
            def stable_content_pathogens_reads_blast = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/pathogen_reads/blast_input/*'], ignoreFile: 'tests/.nftignore')

            //pathogens
            def stable_content_pathogens_reads_consensus = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['pathogens/pathogen_reads/consensus_input/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_pathogens_reads_consensus  = getAllFilesFromDir(params.outdir, include: ['pathogens/pathogen_reads/consensus_input/*.bam'])

            //viral taxid
            def stable_content_viral_taxids = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['viral_taxids/*'], ignoreFile: 'tests/.nftignore')


            assertAll(
		 { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },

                { assert new File("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert snapshot ( stable_name_all ).match("all_files") },

                { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastn/kraken2", include: ['*.txt']).collect{file -> file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastn/centrifuge", include: ['*.txt']).collect{file -> file.getName() + '(centrifuge) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastn/diamond", include: ['*.txt']).collect{file -> file.getName() + "(diamond) " + (file.exists() && (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) ? "contains string:true" : file.exists() ? "exists:true" : "exists:false")})
                .match("blastn")},
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/blast/blastx/kraken2", include: ['*.txt']).collect{file -> file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/blast/blastx/centrifuge", include: ['*.txt']).collect{file -> file.getName() + "(centrifuge) " + (file.exists() && (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) ? "contains string:true" : file.exists() ? "exists:true" : "exists:false")})
                    .match("blastx")},
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/extracted_reads/kraken2", include: ['*.fa']).collect{file -> file.getName() + '(extracted reads kraken2) contains string:' + (file.text.contains("SRR13439790") || file.text.contains("SRR13439813") || file.text.contains("SRR13439799")) },
                    getAllFilesFromDir("$outputDir/extracted_reads/centrifuge", include: ['*.fa']).collect{file -> file.getName() + '(extracted reads centrifuge) contains string:' + (file.text.contains("SRR13439790") || file.text.contains("SRR13439799") || file.text.contains("SRR13439802") || file.text.contains("SRR13439813")) },
                    getAllFilesFromDir("$outputDir/extracted_reads/diamond", include: ['*.fa']).collect{file -> file.getName() + '(extracted reads diamond) contains string:' + (file.text.contains("SRR13439790") ||  file.text.contains("SRR13439813")) } )
                .match("extracted_reads")},
                { assert snapshot (
                    bam_files_bowtie2_align.isEmpty() ? 'No BAM files' : bam_files_bowtie2_align.collect { file -> [file.getName() + " bowtie2 align header: " + bam(file.toString()).getHeader()] },
                    stable_content_bowtie2_align).match("bowtie2_align")},
                { assert snapshot (stable_content_bowtie2_build).match("bowtie2_build")},
                //minimap2 index
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/mapping/minimap2/index", include: ['**/*.mmi']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("minimap2_index")
                },

                { assert snapshot (
                    bam_files_minimap2_align.isEmpty() ? 'No BAM files' : bam_files_minimap2_align.collect { file -> [file.getName() + " minimap2 align md5: " + bam(file.toString()).getReadsMD5()] },
                    stable_content_minimap2_align).match("minimap2_align")},
                // igv
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("igv")
                },
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/pathogens/blast/blastn", include: ['*.txt']).collect{file -> file.getName() + ' contains string:' + (file.exists() && file.text.contains("NC_060947.1") || file.text.contains("NC_002023.1_0") || file.text.contains("")) },
                    getAllFilesFromDir("$outputDir/pathogens/blast/blastx", include: ['*.txt']).collect{file -> file.getName() + ' contains string:' + (file.exists() && file.text.contains("NC_002019.1_0")) })
                .match("pathogens_blast")},
                { assert snapshot (stable_content_pathogens_consensus).match("pathogens_consensus")},
                 // pathogens igv
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/pathogens/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("pathogens_igv")
                },

                //pathogens reads blast input
                { assert snapshot (stable_content_pathogens_reads_blast).match("pathogens_reads_blast")},

                //pathogens reads consensus
                { assert snapshot (
                    bam_files_pathogens_reads_consensus.isEmpty() ? 'No BAM files' : bam_files_pathogens_reads_consensus.collect { file -> [file.getName() + " pathogens reads consensus md5: " + bam(file.toString()).getHeader()] },
                    stable_content_pathogens_reads_consensus).match("pathogens_reads_consensus")},


                // spades kraken2
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/spades/kraken2", include: ['*.fa','*log']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("spades_kraken2")
                },

                { assert snapshot(
                        getAllFilesFromDir("$outputDir/spades/centrifuge", include: ['*.fa','*log']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("spades_centrifuge")
                },

                { assert snapshot(
                        getAllFilesFromDir("$outputDir/spades/diamond", include: ['*.fa','*log']).collect { file -> file.getName() + " exists: "+ file.exists() }
                    ).match("spades_diamond")
                },

                {assert snapshot (stable_content_viral_taxids).match("viral_taxids")},

            )
        }
    }

}
