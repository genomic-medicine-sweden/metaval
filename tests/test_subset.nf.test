nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_subset"
    profile "test_subset"


    test("-profile test_subset") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {

            def stable_name_all      = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            //blastn: partly unstable files, see custom assertions
            //blastx: partly unstable files, see custom assertions

            //extracted_reads:partly unstable files, see custom assertions

            //bowtie2 align: partly unstable files, see custom assertions
            def bam_files_bowtie2_align  = getAllFilesFromDir(params.outdir, include: ['verifyspecies/mapping/bowtie2/align/*.bam'])

            //bowtie2 build
            def stable_content_bowtie2_build = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/mapping/bowtie2/build/mappingorganism_*/bowtie2/*'], ignoreFile: 'tests/.nftignore')

            //minimap2 index: partly unstable files, see custom assertions

            //minimap2 align
            def stable_content_minimap2_align = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/mapping/minimap2/align/*'], ignoreFile: 'tests/.nftignore')
            def bam_files_minimap2_align  = getAllFilesFromDir(params.outdir, include: ['verifyspecies/mapping/minimap2/align/*bam'])

            //report: partly unstable files, see custom assertions

	          //consensus raw
            def stable_content_consensus_raw = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/consensus/raw/*.fasta'], ignoreFile: 'tests/.nftignore')

            //consensus filtered
            def stable_content_consensus_filtered = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/consensus/filtered/*.fasta'], ignoreFile: 'tests/.nftignore')

            // samtools coverage
            def stable_content_samtools_coverage = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/samtools/coverage/*.txt'], ignoreFile: 'tests/.nftignore')

            // samtools coverage plot:partly unstable files, see custom assertions

            // samtools depth
            def stable_content_samtools_depth = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/samtools/depth/*.tsv'], ignoreFile: 'tests/.nftignore')

            // taxpasta flagged
            def stable_content_taxpasta_flagged = getAllFilesFromDir(params.outdir, relative: false, includeDir: false, include :['verifyspecies/taxpasta_flagged/*.tsv'], ignoreFile: 'tests/.nftignore')

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },

                { assert new File("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert snapshot ( stable_name_all ).match("all_files") },

                // blastn
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/blastn/kraken2", include: ['*.txt']).collect{file ->
                        file.getName() + '(kraken2) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza") || file.text.contains("Shigella")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/blastn/centrifuge", include: ['*.txt']).collect{file ->
                        file.getName() + '(centrifuge) contains string:' + (file.text.contains("Chryseobacterium") || file.text.contains("Influenza")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/blastn/diamond", include: ['*.txt']).collect{file ->
                        file.getName() + '(diamond) ' + (file.text.contains("Chryseobacterium") || file.text.contains("Shigella")) }
                ).match("blastn") },

                // blastx
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/blastx/kraken2", include: ['*.txt']).collect{file ->
                        file.getName() + '(kraken2) contains string:' + (file.text.contains("Escherichia") || file.text.contains("Influenza") ) },
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/blastx/centrifuge", include: ['*.txt']).collect{file ->
                        file.getName() + "(centrifuge) " + (
                            file.exists() && (file.text.contains("Chryseobacterium") ||
                            file.text.contains("Influenza") ) ? "contains string:true" : file.exists() ? "exists:true" : "exists:false")}
                ).match("blastx") },

                // extracted reads
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/verifyspecies/extracted_reads/kraken2", include: ['*.fa']).collect{file ->
                        file.getName() + '(extracted reads kraken2) contains string:' + (file.text.contains("SRR13439790") || file.text.contains("SRR13439813") || file.text.contains("SRR13439799")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/extracted_reads/centrifuge", include: ['*.fa']).collect{file ->
                        file.getName() + '(extracted reads centrifuge) contains string:' + (
                            file.text.contains("SRR13439790") ||
                            file.text.contains("SRR13439799") ||
                            file.text.contains("SRR13439802") ||
                            file.text.contains("SRR13439813")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/extracted_reads/diamond", include: ['*.fa']).collect{file ->
                        file.getName() + '(extracted reads diamond) contains string:' + (file.text.contains("SRR13439790") ||  file.text.contains("SRR13439813")) }
                ).match("extracted_reads") },

                // Reads subset
                { assert snapshot(
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/reads_subset/kraken2", include: ['*.fa']).collect{file ->
                        file.getName() + '(kraken2 reads subset) contains string:' + (file.text.contains("SRR13439799") ||  file.text.contains("SRR13439813")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/reads_subset/centrifuge", include: ['*.fa']).collect{file ->
                        file.getName() + '(centrifuge reads subset) contains string:' + (file.text.contains("SRR13439799") ||  file.text.contains("SRR13439813")) },
                    getAllFilesFromDir("$outputDir/verifyspecies/blast/reads_subset/diamond", include: ['*.fa']).collect{file ->
                        file.getName() + '(diamond reads subset) contains string:' + (file.text.contains("SRR13439813")) },
                ).match("reads_subset") },

                // bowtie2
                { assert snapshot (
                    bam_files_bowtie2_align.isEmpty() ? 'No BAM files' : bam_files_bowtie2_align.collect { file -> [file.getName() + " bowtie2 align header: " + bam(file.toString()).getHeader()] }
                ).match("bowtie2_align") },
                { assert snapshot (stable_content_bowtie2_build).match("bowtie2_build") },

                //minimap2 index
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/verifyspecies/mapping/minimap2/index", include: ['**/*.mmi']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("minimap2_index") },
                { assert snapshot (
                    bam_files_minimap2_align.isEmpty() ? 'No BAM files' : bam_files_minimap2_align.collect { file -> [file.getName() + " minimap2 align md5: " + bam(file.toString()).getReadsMD5()] },
                    stable_content_minimap2_align
                ).match("minimap2_align") },

                // igv
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/verifyspecies/igv", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("igv") },

                //metaval report
                { assert snapshot (
                    getAllFilesFromDir("$outputDir/verifyspecies/report", include: ['*.html']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("report") },

	            //consensus raw
                { assert snapshot (getAllFilesFromDir("$outputDir/verifyspecies/consensus/raw", include: ['*.fasta']).collect{file ->
                        file.getName() + '(Raw consensus for verify species workflow) contains string:'+ (
                            file.text.contains(">MZ358387.1") ||
                            file.text.contains(">AP014624.1") ||
                            file.text.contains(">EF467817.1") ||
                            file.text.contains(">MW630115.1")) },
                            stable_content_consensus_raw
                ).match("consensus_raw") },

                //consensus filtered
                { assert snapshot (stable_content_consensus_filtered).match("consensus_filtered")},


                // samtools coverage
                { assert snapshot (stable_content_samtools_coverage).match("samtools_coverage") },

                // samtools coverage plot
                { assert snapshot(
                        getAllFilesFromDir("$outputDir/verifyspecies/samtools/coverage_plot", include: ['*.png']).collect { file -> file.getName() + " exists: "+ file.exists() }
                ).match("samtools_coverage_plot") },

                // samtools depth
                { assert snapshot (stable_content_samtools_depth).match("samtools_depth") },

                //taxpasta flagged
                { assert snapshot (stable_content_taxpasta_flagged).match("taxpasta_flagged") },


            )
        }
    }

}
