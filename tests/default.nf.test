nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_taxid"
    profile "test_taxid"


    test("-profile test_taxid") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name_all      = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            //blastn
            def stable_content_blastn = getAllFilesFromDir("$outputDir/blast/blastn", relative: true, includeDir: false, ignore: null, ignoreFile: 'tests/.nftignore', include: ['*','**/*'])

            //blastx
            def stable_content_blastx = getAllFilesFromDir("$outputDir/blast/blastx", relative: true, includeDir: false, ignore: null, ignoreFile: 'tests/.nftignore', include: ['*','**/*'])

            //igv
            def stable_content_igv = getAllFilesFromDir("$outputDir/igv", relative: true, includeDir: false, ignore: null, ignoreFile: 'tests/.nftignore', include: ['*','**/*'])


            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },

                { assert new File("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml").exists() },
                { assert new File("$outputDir/multiqc/multiqc_report.html").exists() },
                { assert snapshot(
                    file("$outputDir/blast/blastn/centrifuge/SRR13439790_878220_blast_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439790_878220_blast_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439790_878220_blast.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439799_211044_blast_filtered_summary.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439799_211044_blast_filtered.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439799_211044_blast.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439802_878220_blast_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439802_878220_blast_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439802_878220_blast.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439813_878220_blast_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439813_878220_blast_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/centrifuge/SRR13439813_878220_blast.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_1920753_blast_filtered_summary.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_1920753_blast_filtered.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_1920753_blast.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_878220_blast_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_878220_blast_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/diamond/SRR13439813_878220_blast.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439799_211044_blast_filtered_summary.txt").text.contains("Influenza"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439799_211044_blast_filtered.txt").text.contains("Influenza"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439799_211044_blast.txt").text.contains("Influenza"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_1920753_blast_filtered_summary.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_1920753_blast_filtered.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_1920753_blast.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_878220_blast_filtered_summary.txt").text.contains("SRR13439813_878220_blast_filtered_summary"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_878220_blast_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastn/kraken2/SRR13439813_878220_blast.txt").text.contains("Chryseobacterium"),
                    stable_content_blastn).match("blastn")},
                { assert snapshot(
                    file("$outputDir/blast/blastx/centrifuge/SRR13439790_878220_blastx.txt").exists(),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439799_211044_blastx_filtered_summary.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439799_211044_blastx_filtered.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439799_211044_blastx.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439802_878220_blastx.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439813_878220_blastx_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439813_878220_blastx_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/centrifuge/SRR13439813_878220_blastx.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/diamond/SRR13439813_1920753_blastx.txt").text.contains("Shigella"),
                    file("$outputDir/blast/blastx/diamond/SRR13439813_878220_blastx_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/diamond/SRR13439813_878220_blastx_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/diamond/SRR13439813_878220_blastx.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439799_211044_blastx_filtered_summary.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439799_211044_blastx_filtered.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439799_211044_blastx.txt").text.contains("Influenza A virus"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_1920753_blastx_filtered_summary.txt").text.contains("Escherichia phage"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_1920753_blastx_filtered.txt").text.contains("Shigella virus"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_1920753_blastx.txt").text.contains("Shigella virus"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_878220_blastx_filtered_summary.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_878220_blastx_filtered.txt").text.contains("Chryseobacterium"),
                    file("$outputDir/blast/blastx/kraken2/SRR13439813_878220_blastx.txt").text.contains("Chryseobacterium"),
                    stable_content_blastx).match("blastx")},
                { assert snapshot (path("$outputDir/extracted_reads")).match("extracted_reads")},
                { assert snapshot(
                    file("$outputDir/igv/SRR13439790_centrifuge_taxid_878220_mappingorganism_Chryseobacterium_sp._StRB126_CFB_group_bacteria_report.html").exists(),
                    file("$outputDir/igv/SRR13439799_centrifuge_taxid_211044_mappingorganism_Influenza_A_virus_A_Puerto_Rico_8_1934_H1N1_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_Bp4_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_EC1-UPM_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_ECBP1_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_IME11_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_PGN829.1_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_phi_G17_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_St11Ph5_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_U1G_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_vB_EcoP_G7C_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_vB_EcoP_PhAPEC5_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_vB_EcoP_PhAPEC7_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_vB_EcoP_SP5M_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Escherichia_phage_vB_EcoP-ZQ2_report.html").exists(),
                    file("$outputDir/igv/SRR13439813_kraken2_taxid_1920753_mappingorganism_Shigella_phage_pSb-1_report.html").exists(),
                    stable_content_igv).match("igv")},
            )
        }
    }
}
