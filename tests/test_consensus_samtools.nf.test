nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "gms_metaval"
    tag "test_consensus_samtools"
    profile "test_consensus_samtools"


    test("-profile test_consensus_samtools") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            ///////////////////
            // DOCUMENTATION //
            ///////////////////

            // The contents of each top level results directory should be tested with individually named snapshots.
            // Within each snapshot, there should be two to three distinct variables, that contain the files to be tested.
            //    - stable_name_<dir> is for files with variable md5sums (i.e. content) so only names will be compared
            //    - stable_content_<dir> is for files with stable md5sums (i.e. content) so md5sums will be compared
            //    - bams_<dir> is for BAM files, where the headerMD5 is checked for stability (since the content can be unstable)
            // If a directory is fully stable, you can drop `stable_name_*`
            // If a directory contains no BAMs, you can drop `bams_*`

            // Generate with: nf-test test --tag test_consensus_samtools --profile=+singularity --verbose --debug --update-snapshot
            // Test with:     nf-test test --tag test_consensus_samtools --profile=+singularity

            //////////////////////
            // DEFINE VARIABLES //
            //////////////////////

            // Define exclusion patterns for files with unstable contents
            // NOTE: When a section needs more than a couple of small patterns, consider adding a variable to store the patterns here
            //       This is particularly important if the patterns excluded in the stable content section should be included in the stable name section
            def unstable_patterns_multiqc = [
                '**/multiqc_data/fastqc_top_overrepresented_sequences_table.txt',
                '**/multiqc_data/fastqc_top_overrepresented_sequences_table.txt',
                '**/multiqc_data/multiqc.log',
                '**/multiqc_data/multiqc_data.json',
                '**/multiqc_data/multiqc_sources.txt',
                '**/multiqc_data/multiqc_software_versions.txt',
                '**/multiqc_plots/{svg,pdf,png}/*.{svg,pdf,png}',
                '**/multiqc_report.html',
                '**/multiqc_data/*.txt'
            ]

            // Check that no files are missing/added
            // Command legend:                                                  Result directory to index    , includeDir: include dirs?, ignore: exclude patterns                   , ignoreFile: exclude pattern list, include: include patterns
            def stable_name_all                          = getAllFilesFromDir("$outputDir/"                          , relative: true, includeDir: false, ignore: ['pipeline_info/*.{html,json,txt}'], ignoreFile: null, include: ['*', '**/*'])

            // MultiQC
            def stable_content_multiqc                   = getAllFilesFromDir("$outputDir/multiqc"                   , relative: true, includeDir: false, ignore: unstable_patterns_multiqc          , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_multiqc                      = getAllFilesFromDir("$outputDir/multiqc"                   , relative: true, includeDir: false, ignore:  null                              , ignoreFile: null, include: unstable_patterns_multiqc)

            // Pathogens/blast/blastn
            def stable_content_pathogens_blastn          = getAllFilesFromDir("$outputDir/pathogens/blast/blastn"    , relative: true, includeDir: false, ignore: ['**/*.txt']                       , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_blastn             = getAllFilesFromDir("$outputDir/pathogens/blast/blastn"    , relative: true, includeDir: false, ignore: null                               , ignoreFile: null, include: ['**/*.txt'])

            // Pathogens/blast/blastx
            def stable_content_pathogens_blastx          = getAllFilesFromDir("$outputDir/pathogens/blast/blastx"   , relative: true, includeDir: false, ignore: ['**/*.txt']                        , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_blastx             = getAllFilesFromDir("$outputDir/pathogens/blast/blastx"   , relative: true, includeDir: false, ignore: null                                , ignoreFile: null, include: ['**/*.txt'])

            // Pathogens/bowtie2/
            def stable_content_pathogens_bowtie2         = getAllFilesFromDir("$outputDir/pathogens/bowtie2"        , relative: true, includeDir: false, ignore: ['**/align/*']                      , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_bowtie2            = getAllFilesFromDir("$outputDir/pathogens/bowtie2"        , relative: true, includeDir: false, ignore: null                                , ignoreFile: null, include: ['**/align/*'])

            // Pathogens/consensus
            def stable_content_pathogens_consensus       = getAllFilesFromDir("$outputDir/pathogens/consensus/"     , relative: true, includeDir: false, ignore: ['**/*']                            , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_consensus          = getAllFilesFromDir("$outputDir/pathogens/consensus"      , relative: true, includeDir: false, ignore: null                                , ignoreFile: null, include: ['**/*'])

            // Pathogens/minimap2
            def stable_content_pathogens_minimap2        = getAllFilesFromDir("$outputDir/pathogens/minimap2"      , relative: true, includeDir: false, ignore: ['**/align/*']                       , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_minimap2           = getAllFilesFromDir("$outputDir/pathogens/minimap2"      , relative: true, includeDir: false, ignore: null                                 , ignoreFile: null, include: ['**/align/*'])

            // Pathogens/pathogen_reads
            def stable_content_pathogens_pathogen_reads  = getAllFilesFromDir("$outputDir/pathogens/pathogen_reads", relative: true, includeDir: false, ignore: ['**/*/*.{fasta.gz,bam,bam.bai}']    , ignoreFile: null, include: ['*', '**/*'])
            def stable_name_pathogens_pathogen_reads     = getAllFilesFromDir("$outputDir/pathogens/pathogen_reads", relative: true, includeDir: false, ignore: null                                 , ignoreFile: null, include: ['**/*/*.{fasta.gz,bam,bam.bai}'])

            // BAM filer header
            def bam_files_bowtie2                        = getAllFilesFromDir( "$outputDir/pathogens/bowtie2/align", relative: false, includeDir: false, ignore: ['**/*.bai']                         , ignoreFile: null, include: ['**/*.bam'])
            def bam_files_minimap2                       = getAllFilesFromDir( "$outputDir/pathogens/bowtie2/align", relative: false, includeDir: false, ignore: ['**/*.bai']                         , ignoreFile: null, include: ['**/*.bam'])
            def bam_files = bam_files_bowtie2 + bam_files_minimap2

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/genomic-medicine-sweden_metaval_software_mqc_versions.yml"),
                ).match() },
                // This checks that there are no missing or additional output files.
                // Also a good starting point to look at all the files in the output folder than need to be checked in subsequent sections.
                { assert snapshot ( stable_name_all                               ).match("all_files") },

                // Checking changes to contents of each section
                // NOTE: Keep the order of the sections in the alphanumeric order of the output directories.
                //    Each section should first check stable_content, stable_name second (if applicable).
                { assert snapshot ( stable_content_multiqc                 , stable_name_multiqc                 ).match("multiqc" ) },
                { assert snapshot ( stable_content_pathogens_blastn        , stable_name_pathogens_blastn        ).match("pathogens/blast/blastn") },
                { assert snapshot ( stable_content_pathogens_blastx        , stable_name_pathogens_blastx        ).match("pathogens/blast/blastx") },
                { assert snapshot ( stable_content_pathogens_bowtie2       , stable_name_pathogens_bowtie2       ).match("pathogens/bowtie2/") },
                { assert snapshot ( stable_content_pathogens_consensus     , stable_name_pathogens_consensus     ).match("pathogens/consensus") },
                { assert snapshot ( stable_content_pathogens_minimap2      , stable_name_pathogens_minimap2      ).match("pathogens/minimap2") },
                { assert snapshot ( stable_content_pathogens_pathogen_reads, stable_name_pathogens_pathogen_reads).match("pathogens/pathogen_reads") },
                //check the header of bam file
                { assert snapshot( bam_files.collect{ bam(it).getHeaderMD5()}).match("Header MD5") },
                // Check the consensus sequence
                { assert path("$outputDir/pathogens/consensus/SRR13439799_211044_samtools.fasta").readLines().any { l -> l.contains('>NC_002023.1')} }

            )
        }
    }
}
